     =================== 대시 보드 리스트 영역 =================== 

    <select id="selectRecentReports" resultType="reportDto">
        SELECT 
            REPORT_NO as reportNo,
            REPORT_TYPE as reportType,
            REPORTEE_NO as reporteeNo,
            REPORT_REASON as reportReason,
            DATE_FORMAT(CREATE_DATE, '%Y-%m-%d') as createdAt
        FROM REPORT
        ORDER BY CREATE_DATE DESC
        LIMIT 5
    </select>

    <select id="selectTopRecipes" resultType="recipeDto">

        SELECT 
            BOARD_NO as boardNo,
            BOARD_TITLE as boardTitle,
            NICKNAME as nickname,
            LIKES_COUNT as likesCount,
            VIEW_COUNT as viewCount
        FROM BOARD
        ORDER BY LIKES_COUNT DESC, VIEW_COUNT DESC
        LIMIT 5
    </select>

    <select id="selectUnansweredInquiries" resultType="inquiryDto">
        SELECT 
            INQUIRY_ID as inquiryId,
            USER_ID as userId,
            TITLE as title,
            STATUS as status,
            DATE_FORMAT(CREATE_DATE, '%Y-%m-%d') as createdAt
        FROM INQUIRIES
        WHERE STATUS = 'N'
        ORDER BY CREATE_DATE ASC
    </select>

    <select id="selectNotice" resultType="string">
        SELECT CONTENT FROM (
            SELECT CONTENT FROM NOTICES ORDER BY CREATE_DATE DESC
        ) LIMIT 1
    </select>

