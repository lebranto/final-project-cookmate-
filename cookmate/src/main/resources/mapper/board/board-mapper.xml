<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="boardmapper">

    <!-- ── ResultMap ──────────────────────────── -->

    <resultMap id="boardDetailMap"
               type="com.kh.cookmate.board.dto.BoardDto$BoardDetail">
        <result property="boardNo"      column="BOARD_NO"/>
        <result property="userNo"       column="USER_NO"/>
        <result property="typeNo"       column="TYPE_NO"/>
        <result property="boardTitle"   column="BOARD_TITLE"/>
        <result property="nickname"     column="NICKNAME"/>
        <result property="introduce"    column="INTRODUCE"/>
        <result property="imageUrl"     column="IMAGE_URL"/>
        <result property="url"          column="URL"/>
        <result property="open"         column="OPEN"/>
        <result property="likesCount"   column="LIKES_COUNT"/>
        <result property="typeName"     column="TYPE_NAME"/>
        <result property="difficult"    column="DIFFICULT"/>
        <result property="cookTime"     column="COOK_TIME"/>
        <result property="calory"       column="CALORY"/>
        <result property="ai"           column="AI"/>
        <collection property="ingredientSets"
                    column="BOARD_NO"
                    select="selectIngredientSetDetail"/>
        <collection property="cookSteps"
                    column="BOARD_NO"
                    select="selectCookStepList"/>
    </resultMap>

    <resultMap id="ingredientSetDetailMap"
               type="com.kh.cookmate.board.dto.IngredientSetDto$SetDetail">
        <result property="setNo" column="SET_NO"/>
        <collection property="ingredients"
                    column="SET_NO"
                    select="selectIngredientList"/>
    </resultMap>

    <!-- ── BOARD ──────────────────────────────── -->

    <!-- 공식 레시피 수 조회 -->
    <select id="countApiRecipes" resultType="int">
        SELECT COUNT(*) FROM BOARD WHERE IS_API_DATA = 'Y'
    </select>

    <!-- 레시피 등록 -->
    <insert id="insertBoard" parameterType="Board"
            useGeneratedKeys="true" keyProperty="boardNo">
        INSERT INTO BOARD (
            USER_NO, TYPE_NO, BOARD_TITLE, NICKNAME,
            INTRODUCE, IMAGE_URL, URL, OPEN,
            IS_API_DATA, LIKES_COUNT, BOARD_DELETE, BOARD_POSTDATE
        ) VALUES (
            #{userNo}, #{typeNo}, #{boardTitle}, #{nickname},
            #{introduce}, #{imageUrl}, #{url}, #{open},
            #{isApiData}, 0, 'N', NOW()
        )
    </insert>

    <!-- 레시피 상세 조회 -->
    <select id="getBoardDetail" parameterType="int" resultMap="boardDetailMap">
        SELECT
            b.BOARD_NO, b.USER_NO, b.TYPE_NO, b.BOARD_TITLE,
            b.NICKNAME, b.INTRODUCE, b.IMAGE_URL, b.URL,
            b.OPEN, b.LIKES_COUNT, b.BOARD_POSTDATE,
            t.TYPE_NAME, t.DIFFICULT, t.COOK_TIME, t.CALORY, t.AI
        FROM BOARD b
        JOIN TAG t ON b.TYPE_NO = t.TYPE_NO
        WHERE b.BOARD_NO = #{boardNo}
          AND b.BOARD_DELETE = 'N'
    </select>


    <!-- TAG  -->

    <!-- 태그 등록 -->
    <insert id="insertTag" parameterType="Tag"
            useGeneratedKeys="true" keyProperty="typeNo">
        INSERT INTO TAG (TYPE_NAME, DIFFICULT, COOK_TIME, CALORY, AI)
        VALUES (#{typeName}, #{difficult}, #{cookTime}, #{calory}, #{ai})
    </insert>

    <!--INGREDIENT_SET -->

    <!-- 재료 묶음 등록 -->
    <insert id="insertIngredientSet" parameterType="IngredientSet"
            useGeneratedKeys="true" keyProperty="setNo">
        INSERT INTO INGREDIENT_SET (BOARD_NO) VALUES (#{boardNo})
    </insert>

    <!-- 재료 묶음 상세 조회 (ResultMap용) -->
    <select id="selectIngredientSetDetail" parameterType="int"
            resultMap="ingredientSetDetailMap">
        SELECT SET_NO FROM INGREDIENT_SET WHERE BOARD_NO = #{boardNo}
    </select>


    <!-- INGREDIENT -->

    <!-- 재료 단건 등록 -->
    <insert id="insertIngredient" parameterType="Ingredient">
        INSERT INTO INGREDIENT (SET_NO, INGREDIENT_NAME, QUANTITY, UNIT)
        VALUES (#{setNo}, #{ingredientName}, #{quantity}, #{unit})
    </insert>

    <!-- 재료 여러건 등록 (foreach) -->
    <insert id="insertIngredients" parameterType="java.util.List">
        INSERT INTO INGREDIENT (SET_NO, INGREDIENT_NAME, QUANTITY, UNIT) VALUES
        <foreach collection="list" item="ing" separator=",">
            (#{ing.setNo}, #{ing.ingredientName}, #{ing.quantity}, #{ing.unit})
        </foreach>
    </insert>

    <!-- 재료 조회 (ResultMap용) -->
    <select id="selectIngredientList" parameterType="int"
            resultType="com.kh.cookmate.board.dto.IngredientDto$IngDetail">
        SELECT INGREDIENT_NO, INGREDIENT_NAME, QUANTITY, UNIT
        FROM INGREDIENT WHERE SET_NO = #{setNo}
    </select>

    <!-- COOK_STEP  -->

    <!-- 조리단계 여러건 등록 (foreach) -->
    <insert id="insertCookSteps" parameterType="java.util.List">
        INSERT INTO COOK_STEP (BOARD_NO, COOK_CONTENT, COOK_IMAGE, STEP) VALUES
        <foreach collection="list" item="step" separator=",">
            (#{step.boardNo}, #{step.cookContent}, #{step.cookImage}, #{step.step})
        </foreach>
    </insert>

    <!-- 조리단계 조회 (ResultMap용) -->
    <select id="selectCookStepList" parameterType="int"
            resultType="com.kh.cookmate.board.dto.CookStepDto$StepDetail">
        SELECT STEP, COOK_CONTENT, COOK_IMAGE
        FROM COOK_STEP
        WHERE BOARD_NO = #{boardNo}
        ORDER BY STEP ASC
    </select>

    

</mapper>